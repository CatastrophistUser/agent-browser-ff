---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
const repo = 'https://github.com/CatastrophistUser/agent-browser-ff';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>agent-browser-ff | Firefox automation for AI agents</title>
  <meta name="description" content="Browser automation CLI for AI agents and humans, built on Firefox." />
  <style is:global>
    :root {
      --bg: #fafafa; --fg: #000; --muted: #666; --line: #e5e5e5; --term: #ffffff; --btn: #171717; --btn-fg: #fff;
      --ok: #0a7f3f; --ref: #b45309;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0a0a0a; --fg: #fff; --muted: #a1a1a1; --line: #262626; --term: #111; --btn: #fff; --btn-fg: #000; --ok: #4ade80; --ref: #fdba74; }
    }
    * { box-sizing: border-box; margin: 0; }
    html, body { height: 100%; overflow: hidden; }
    body { background: var(--bg); color: var(--fg); font-family: 'Geist Variable', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    .page { height: 100dvh; display: grid; grid-template-rows: auto 1fr auto; padding: 0 clamp(20px, 5vw, 64px); }
    nav { display: flex; align-items: center; justify-content: space-between; height: 64px; font-size: 14px; }
    nav .brand { font-weight: 600; letter-spacing: -0.01em; }
    nav .links { display: flex; gap: 24px; color: var(--muted); }
    nav a { color: inherit; text-decoration: none; } nav a:hover { color: var(--fg); }
    main { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: center; min-height: 0; }
    h1 { font-size: clamp(2.4rem, 5.4vw, 4.6rem); line-height: 1.03; letter-spacing: -0.045em; font-weight: 600; }
    .sub { margin-top: 20px; color: var(--muted); font-size: 1.05rem; line-height: 1.55; max-width: 30rem; }
    .actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .btn { display: inline-flex; align-items: center; height: 40px; padding: 0 20px; border-radius: 9999px; font-size: 14px; font-weight: 500; text-decoration: none; background: var(--btn); color: var(--btn-fg); }
    .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
    .install { display: inline-flex; gap: 10px; align-items: center; height: 40px; padding: 0 16px; border-radius: 9999px; background: var(--term); box-shadow: inset 0 0 0 1px var(--line); font: 13px 'Geist Mono Variable', monospace; cursor: pointer; border: 0; color: var(--fg); }
    .install span { color: var(--muted); }
    .tags { margin-top: 28px; font: 12.5px 'Geist Mono Variable', monospace; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 18px; }
    .term { background: var(--term); border-radius: 8px; box-shadow: 0 0 0 1px var(--line); overflow: hidden; }
    .term .bar { display: flex; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
    .term .bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
    pre { padding: 18px 20px; font: 13px/1.7 'Geist Mono Variable', monospace; white-space: pre; overflow: hidden; }
    .c { color: var(--muted); } .p { color: var(--muted); } .ok { color: var(--ok); } .r { color: var(--ref); }
    footer { height: 56px; display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: var(--muted); }
    footer a { color: inherit; }
    @media (max-width: 820px) { main { grid-template-columns: 1fr; align-content: center; } .term { display: none; } }
  </style>
</head>
<body>
  <div class="page">
    <nav>
      <a class="brand" href="/">agent-browser-ff</a>
      <div class="links"><a href="/getting-started/introduction/">Docs</a><a href="/commands/launch/">Commands</a><a href={repo}>GitHub</a></div>
    </nav>
    <main>
      <section>
        <h1>Browser automation built for any agent</h1>
        <p class="sub">A Firefox-first CLI for AI agents and humans. Compact snapshots, element refs, macros, and a headed mode you can watch.</p>
        <div class="actions">
          <a class="btn" href="/getting-started/introduction/">Get started</a>
          <button class="install" onclick="navigator.clipboard.writeText('npm install -g agent-browser-ff')"><span>$</span>npm install -g agent-browser-ff</button>
        </div>
        <div class="tags"><span>refs</span><span>--gui</span><span>macros</span><span>scrape</span><span>crawl</span><span>vault</span></div>
      </section>
      <section class="term" aria-label="Example session">
        <div class="bar"><i></i><i></i><i></i></div>
<pre><span class="p">$</span> agent-browser-ff open example.com
<span class="ok">opened</span> https://example.com

<span class="p">$</span> agent-browser-ff snapshot
heading "Example Domain"
paragraph "This domain is for use in…"
link <span class="r">@e1</span> "More information..."

<span class="p">$</span> agent-browser-ff click <span class="r">@e1</span>
<span class="ok">clicked</span> <span class="r">@e1</span> "More information..."

<span class="p">$</span> agent-browser-ff open example.com <span class="r">--gui</span>
<span class="c"># same session, Firefox headed, overlay on</span></pre>
      </section>
    </main>
    <footer><span>Open source · MIT</span><a href={repo}>CatastrophistUser/agent-browser-ff</a></footer>
  </div>
</body>
</html>
